<Window
    x:Class="LEDVision.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:LEDVision"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LED VISION 2.0"
    Width="1920"
    Height="1080"
    WindowState="Maximized"

    Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="10*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="8*" />
            <RowDefinition Height="0.25*" />
        </Grid.RowDefinitions>

        <Image Source="Images/Moonsung Icon.png" />
        <Image Grid.Row="2" Source="Images/TNG Logo.png" />

        <Label
            Grid.Column="1"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="#323F4E"
            Content="LED VISION"
            FontSize="30"
            Foreground="White" />

        <StackPanel
            Grid.Row="1"
            Background="#323F4E"
            Orientation="Vertical">

            <Button
                x:Name="changeModelBtn"
                Margin="0,18,0,0"
                Background="Transparent"
                BorderThickness="0"
                Click="changeModelBtn_Click"
                ToolTip="Open Model">
                <fa:IconImage
                    Width="50"
                    Height="50"
                    Foreground="#80C4E9"
                    Icon="FolderOpen" />
            </Button>

            <Button
                x:Name="saveModelBtn"
                Margin="0,18,0,0"
                Background="Transparent"
                BorderThickness="0"
                Click="SaveBtn_Click"
                ToolTip="Save Model">
                <fa:IconImage
                    Width="50"
                    Height="50"
                    Foreground="#80C4E9"
                    Icon="FloppyDisk" />
            </Button>

            <ToggleButton
                x:Name="autoPageBtn"
                Margin="0,18,0,0"
                Padding="5"
                Background="Transparent"
                BorderThickness="0"
                Click="ToggleBtn_Click">
                <fa:IconImage
                    Width="50"
                    Height="50"
                    Foreground="#80C4E9"
                    Icon="Check" />
            </ToggleButton>
            <ToggleButton
                x:Name="visionPageBtn"
                Margin="0,18,0,0"
                Background="Transparent"
                BorderThickness="0"
                Click="ToggleBtn_Click">
                <fa:IconImage
                    Width="50"
                    Height="50"
                    Foreground="#80C4E9"
                    Icon="Eye" />
            </ToggleButton>
            <ToggleButton
                x:Name="settingPageBtn"
                Margin="0,18,0,0"
                Background="Transparent"
                BorderThickness="0"
                Click="ToggleBtn_Click">
                <fa:IconImage
                    Width="50"
                    Height="50"
                    Foreground="#80C4E9"
                    Icon="Gears" />
            </ToggleButton>
        </StackPanel>

        <Frame
            x:Name="autoPageHolder"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="Collapsed" />
        <Frame
            x:Name="visionPageHolder"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="Collapsed" />
        <Frame
            x:Name="settingPageHolder"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="Collapsed" />

        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Background="#323F4E"
            Orientation="Horizontal" />
    </Grid>
</Window>