<Window
    x:Class="LEDVision.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:LEDVision"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LED COLOR INSPECTION"
    Icon="Images/app.ico"
    Width="1920"
    Height="1080"
    WindowStyle="None"
    ResizeMode="NoResize"

    Loaded="Window_Loaded">
    <!--  Thanh tiêu đề tự làm: bỏ khung mặc định của Windows. Cửa sổ luôn phóng to, không cho kéo / resize.  -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!--  Nút Open / Save: cùng kiểu với nút tab (vuông, icon xanh, rê chuột sáng nhẹ)  -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#80C4E9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E4C5E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#80C4E9" />
                                <Setter Property="Foreground" Value="#323F4E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Nút cửa sổ (thu nhỏ / phóng to / đóng) ở góc phải thanh top  -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#46556A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Nút chuyển trang trên thanh top: nền trong suốt, rê chuột sáng nhẹ, tab đang chọn có nền đậm hơn + vạch cam dưới chân  -->
        <Style x:Key="NavToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#80C4E9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!--  Rê chuột: sáng nhẹ. Tab đang chọn: nền xanh nhạt + icon màu tối (trigger sau thắng trigger trước)  -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E4C5E" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#80C4E9" />
                    <Setter Property="Foreground" Value="#323F4E" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="8*" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <!--  Thanh tiêu đề: chữ giữa, nút Open / Save model ở góc phải  -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#323F4E">
            <!--  Nút chuyển trang (Auto / Vision / Setting) ở bên trái thanh top, không còn sidebar  -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0">
                <ToggleButton
                    x:Name="autoPageBtn"
                    Style="{StaticResource NavToggle}"
                    Width="56"
                    Height="56"
                    Margin="0"
                    Padding="0"
                    ToolTip="Auto Test"
                    Click="ToggleBtn_Click">
                    <fa:IconImage
                        Width="40"
                        Height="40"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                        Icon="CirclePlay" />
                </ToggleButton>
                <ToggleButton
                    x:Name="visionPageBtn"
                    Style="{StaticResource NavToggle}"
                    Width="56"
                    Height="56"
                    Margin="0"
                    Padding="0"
                    ToolTip="Vision Setting"
                    Click="ToggleBtn_Click">
                    <!--  Mắt + bánh răng nhỏ góc dưới phải: trang Vision cũng là trang cài đặt ROI / camera  -->
                    <Grid Width="44" Height="40">
                        <fa:IconImage
                            Width="37"
                            Height="37"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                            Icon="Eye" />
                        <Ellipse Width="21" Height="21" Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=ToggleButton}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        <fa:IconImage
                            Width="16"
                            Height="16"
                            Margin="0,0,2,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                            Icon="Gear" />
                    </Grid>
                </ToggleButton>
                <ToggleButton
                    x:Name="settingPageBtn"
                    Style="{StaticResource NavToggle}"
                    Width="56"
                    Height="56"
                    Margin="0"
                    Padding="0"
                    ToolTip="Setting"
                    Click="ToggleBtn_Click">
                    <fa:IconImage
                        Width="40"
                        Height="40"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                        Icon="Gears" />
                </ToggleButton>
                <!--  Vạch ngăn giữa nhóm tab và nhóm Open / Save  -->
                <Rectangle Width="1" Height="32" Fill="#4A5A6E" Margin="6,0" VerticalAlignment="Center" />
                <Button
                    x:Name="changeModelBtn"
                    Style="{StaticResource NavBtn}"
                    Click="changeModelBtn_Click"
                    ToolTip="Open Model">
                    <fa:IconImage
                        Width="36"
                        Height="36"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Icon="FolderOpen" />
                </Button>
                <Button
                    x:Name="saveModelBtn"
                    Style="{StaticResource NavBtn}"
                    Click="SaveBtn_Click"
                    ToolTip="Save Model">
                    <fa:IconImage
                        Width="36"
                        Height="36"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Icon="FloppyDisk" />
                </Button>
                <Button
                    x:Name="saveModelAsBtn"
                    Style="{StaticResource NavBtn}"
                    Click="SaveAsBtn_Click"
                    ToolTip="Save Model As...">
                    <!--  Save As = hai đĩa mềm chồng lệch nhau (FontAwesome free không có icon sẵn)  -->
                    <Grid Width="40" Height="40">
                        <fa:IconImage
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Opacity="0.55"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Icon="FloppyDisk" />
                        <fa:IconImage
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Icon="FloppyDisk" />
                    </Grid>
                </Button>
            </StackPanel>

            <!--  Tiêu đề + tên model đang mở (không bắt chuột để không che các nút bên dưới)  -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="LED COLOR INSPECTION" FontSize="30" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text=" - " FontSize="30" Foreground="White" VerticalAlignment="Center" />
                <TextBlock x:Name="modelNameText" Text="NO MODEL" FontSize="30" Foreground="White" VerticalAlignment="Center" ToolTip="Model file currently opened" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                <!--  Kết nối lại camera / COM (icon xanh lá = đang kết nối) + About  -->
                <Button x:Name="reconnectCameraBtn" Style="{StaticResource NavBtn}" Click="ReconnectCamera_Click" ToolTip="Reconnect camera">
                    <fa:IconImage x:Name="reconnectCameraIcon" Width="30" Height="30" Foreground="#80C4E9" Icon="Video" />
                </Button>
                <Button x:Name="reconnectComBtn" Style="{StaticResource NavBtn}" Click="ReconnectCom_Click" ToolTip="Reconnect COM (port chosen in Setting page)">
                    <fa:IconImage x:Name="reconnectComIcon" Width="28" Height="28" Foreground="#80C4E9" Icon="Microchip" />
                </Button>
                <Button x:Name="infoBtn" Style="{StaticResource NavBtn}" Click="InfoBtn_Click" ToolTip="About">
                    <fa:IconImage Width="28" Height="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Icon="CircleInfo" />
                </Button>
                <Rectangle Width="1" Height="32" Fill="#4A5A6E" Margin="6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="savedText" Text="Saved" FontSize="13" Foreground="#06C755" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" />
                <!--  Nút cửa sổ  -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource WinBtn}" Click="MinimizeBtn_Click" ToolTip="Minimize">
                        <fa:IconImage Width="18" Height="18" Foreground="White" Icon="WindowMinimize" />
                    </Button>
                    <Button Style="{StaticResource WinCloseBtn}" Click="CloseBtn_Click" ToolTip="Close">
                        <fa:IconImage Width="20" Height="20" Foreground="White" Icon="Xmark" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Frame
            x:Name="autoPageHolder"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="Collapsed" />
        <Frame
            x:Name="visionPageHolder"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="Collapsed" />
        <Frame
            x:Name="settingPageHolder"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="Collapsed" />

    </Grid>
</Window>