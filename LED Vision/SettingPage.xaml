<Page
    x:Class="LEDVision.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LEDVision"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SettingPage">

    <Grid>
        <StackPanel Margin="5">


            <StackPanel>

                <StackPanel Orientation="Vertical">
                    <Label Content="System Controller" FontWeight="Bold" FontSize="20" />

                    <StackPanel Orientation="Horizontal">
                        <ComboBox
                                x:Name="systemBoardCboBox"
                                Width="100"
                                Height="25"
                                Margin="0,0"
                                SelectedItem="{Binding ComPort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                SelectionChanged="systemBoardCboBox_SelectionChanged" />
                        <Rectangle  x:Name="systemBoardStatus" Width="30" Height="25" Fill="Yellow" />
                        <Button
                                Padding="5 0"
                                Height="25"
                                Cursor="Hand"   

                                Click="ConnectBtn_Click"
                                Content="Connect" />

                        <Button 
                                Width="25"  
                                Height="25" 
                                Margin="5 0"  
                                HorizontalAlignment="Left" 
                                Cursor="Hand"    
                                Click="RefreshComPortBtn_Click" 
                                Background="Transparent" 
                                BorderBrush="Transparent" >
                            <fa:IconImage Foreground="Orange" Icon="Refresh" />

                        </Button>

                    </StackPanel>


                </StackPanel>


                <StackPanel Orientation="Vertical">

                    <Label Content="Log Directory"  FontWeight="Bold" FontSize="20"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                                    Height="25"
                                    Width="400"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    BorderBrush="Black"
                                    IsReadOnly="True"
                                    Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <Button
                                    Height="25"
                                    Width="25"
                                    Margin="5,0,0,0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Cursor="Hand"   
                                    Click="ChangeLogDirectoryBtn_Click">


                            <fa:IconImage Foreground="Orange" Icon="Folder" />


                        </Button>
                    </StackPanel>

                </StackPanel>

                <StackPanel Orientation="Vertical">
                    <Label Content="Retest Managment"  FontWeight="Bold" FontSize="20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" >
                        <StackPanel HorizontalAlignment="Left" Margin="0 0"   >
                            <Label HorizontalContentAlignment="Left" Padding="0 2">Retest Times</Label>
                            <TextBox
                                Height="25"
                                Width="50"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsReadOnly="False"
                                HorizontalContentAlignment="Center"

                                BorderBrush="Black"
                                Text="{Binding RetestTimes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Left"  Margin="10 0">
                            <Label HorizontalContentAlignment="Left" Padding="0 2">Wait Before Retest (ms)</Label>
                            <TextBox
                            Height="25"
                            Width="50"
                                HorizontalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            BorderBrush="Black"
Text="{Binding WaitRetest, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Left" Margin="0 0"  >
                            <Label HorizontalContentAlignment="Left" Padding="0 2">Delay Between UP/DOWN (ms)</Label>
                            <TextBox
                            Height="25"
                            Width="50"
                                HorizontalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            BorderBrush="Black"
Text="{Binding DelayUPDOWN, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
                
                <StackPanel Orientation="Vertical">
                    <Label Content="Pin Replacement"  FontWeight="Bold" FontSize="20"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel HorizontalAlignment="Left">
                            <Label>Current</Label>
                            <TextBox
                                Height="25"
                                Width="50"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsReadOnly="True"
                                                                HorizontalContentAlignment="Center"

                                BorderBrush="Black"
                                Text="{Binding CurNum, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Left" Margin="10 0">
                            <Label>Max Set</Label>
                            <TextBox
                            Height="25"
                            Width="50"
                                HorizontalContentAlignment="Center"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            BorderBrush="Black"
Text="{Binding MaxNum, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                   
                </StackPanel>

            </StackPanel>

            <Button
                Cursor="Hand"
                Padding="5"
                     
                     Margin="0 20"
                HorizontalAlignment="Left"
                     Background="Transparent"
                     BorderBrush="Transparent"
                Click="SaveBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Foreground="Orange" Icon="Save" />
                    <Label FontSize="15">SAVE SETTING</Label>
                </StackPanel>


            </Button>
        </StackPanel>



    </Grid>
</Page>