<Page
    x:Class="LEDVision.SequencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LEDVision"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SequencePage"
    FontFamily="Segoe UI">

    <!--  Cùng bảng màu / kiểu với trang Setting: thẻ trắng vuông góc, nút xám, ô nhập vuông  -->
    <Page.Resources>
        <SolidColorBrush x:Key="Ink" Color="#323F4E" />
        <SolidColorBrush x:Key="Muted" Color="#6B7A8C" />
        <SolidColorBrush x:Key="Line" Color="#DDE3EA" />
        <SolidColorBrush x:Key="Accent" Color="#80C4E9" />
        <SolidColorBrush x:Key="PageBg" Color="#F4F6F8" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="18,14,18,16" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D1DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F4F6F8" />
                                <Setter Property="Foreground" Value="#9AA5B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#E1E5EA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D2D8DF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C0C8D1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D1DB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#C9D1DB" BorderThickness="1" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF2FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF3F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Tiêu đề  -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Test Sequence" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconBtn}" Margin="8,0,0,0" Click="SequenceHelp_Click" ToolTip="Help: commands and columns of the test sequence (EN / TH)">
                        <fa:IconImage Width="18" Height="18" Foreground="{StaticResource Ink}" Icon="CircleQuestion" />
                    </Button>
                </StackPanel>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Steps run top to bottom at every test, after the cylinder is down. Any step that FAILS makes the test NG. The sequence is saved in the model file: press Save (top bar) to apply it to the Auto page." />
            </StackPanel>

            <!--  Bảng step  -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DataGrid x:Name="stepsGrid" AutoGenerateColumns="False" IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E6EBF0" RowBackground="White" AlternatingRowBackground="#F7F9FB" BorderThickness="0"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                          SelectionMode="Single" SelectionUnit="FullRow" FontSize="13" RowHeight="28"
                          SelectionChanged="StepsGrid_SelectionChanged" CellEditEnding="StepsGrid_CellEditEnding">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F4F6F8" />
                            <Setter Property="Foreground" Value="#323F4E" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#DDE3EA" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#80C4E9" />
                                    <Setter Property="Foreground" Value="#323F4E" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Skip}" Value="True">
                                    <Setter Property="Foreground" Value="#9AA5B1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding No}" Width="44" IsReadOnly="True" />
                        <DataGridTextColumn Header="CMD" Binding="{Binding Cmd, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                        <DataGridTextColumn Header="Sub CMD" Binding="{Binding Sub, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        <DataGridTextColumn Header="Target" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                        <DataGridTextColumn Header="Spec" Binding="{Binding Spec, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Timeout" Binding="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="160" />
                        <DataGridTemplateColumn Header="Skip" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" IsChecked="{Binding Skip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!--  Thẻ soạn step  -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Width="360" VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Command" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="cmdCombo" Style="{StaticResource Combo}" SelectionChanged="CmdCombo_SelectionChanged" />

                        <TextBlock Text="Sub Command" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="subCombo" Style="{StaticResource Combo}" />

                        <TextBlock Text="Target" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="targetCombo" Style="{StaticResource Combo}" IsEditable="True" />
                        <TextBlock x:Name="targetHint" Style="{StaticResource Hint}" />

                        <TextBlock Text="Spec" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="specBox" Style="{StaticResource Input}" />
                        <TextBlock x:Name="specHint" Style="{StaticResource Hint}" />

                        <TextBlock Text="Timeout (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="timeoutBox" Style="{StaticResource Input}" />
                        <TextBlock x:Name="timeoutHint" Style="{StaticResource Hint}" />

                        <TextBlock Text="Comment" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="commentBox" Style="{StaticResource Input}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="ADD STEP" Style="{StaticResource PrimaryBtn}" Click="AddStep_Click" ToolTip="Insert a new step after the selected row (at the end if nothing is selected)" />
                            <Button Grid.Column="2" x:Name="updateBtn" Content="UPDATE STEP" Style="{StaticResource PrimaryBtn}" Click="UpdateStep_Click" ToolTip="Write the fields above into the selected step" />
                        </Grid>

                        <Separator Margin="0,16" Background="#E0E5EA" />

                        <TextBlock Text="Step actions" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,6" />
                        <UniformGrid Columns="3">
                            <Button Content="Move Up" Style="{StaticResource ActionBtn}" Click="MoveUp_Click" />
                            <Button Content="Move Down" Style="{StaticResource ActionBtn}" Click="MoveDown_Click" />
                            <Button Content="Duplicate" Style="{StaticResource ActionBtn}" Click="Duplicate_Click" />
                            <Button Content="Move First" Style="{StaticResource ActionBtn}" Click="MoveFirst_Click" />
                            <Button Content="Move Last" Style="{StaticResource ActionBtn}" Click="MoveLast_Click" />
                            <Button Content="Delete" Style="{StaticResource ActionBtn}" Click="Delete_Click" />
                            <Button Content="Delete All" Style="{StaticResource ActionBtn}" Click="DeleteAll_Click" />
                            <Button Content="Default" Style="{StaticResource ActionBtn}" Click="Default_Click" ToolTip="Replace the list with the default sequence: POWER ON, DELAY 1000, then for every group: RELAY n ON, VISION CHECK, RELAY n OFF; POWER OFF at the end" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
