<Page
    x:Class="LEDVision.AutoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LEDVision"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vt="clr-namespace:LEDVision.Camera"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    Title="AutoPage">

    <Grid>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical">
            <!--  Khung chứa CỐ ĐỊNH 680x906 (giữ đúng chỗ trên UI). Canvas căn giữa ở ĐÚNG kích thước tỉ lệ
                  ảnh thô (EnsureSurfaceSized scale tới khi chạm 2 cạnh) — KHÔNG scale thêm → không méo.  -->
            <Grid Width="680" Height="906" Background="Black" Margin="12,12,12,0">
                <Canvas
                    x:Name="mainCanvas"
                    Width="680"
                    Height="906"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
                    <Image
                        x:Name="cameraViewer"
                        Width="680" Height="906" Stretch="Uniform" />
                    <vt:VisionTester
                        x:Name="visionTester"
                        Width="680" Height="906" />
                </Canvas>
            </Grid>
        </StackPanel>

        <!--  Cột phải gom chung: Model + Total/Pass/Fail + Used Pins xếp dọc, căn giữa  -->
        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!--  Banner trạng thái/kết quả: vùng CỐ ĐỊNH trên cùng, chỉ 1 cái hiện → không đè lên số bên dưới  -->
            <Grid Height="240" Margin="0,0,0,16">
                <Label x:Name="ngPopup" HorizontalAlignment="Center" Width="520" Height="220" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Red" Content="NG" FontSize="80" FontWeight="Bold" Foreground="White" Visibility="Collapsed" />
                <Label x:Name="testingPopup" HorizontalAlignment="Center" Width="520" Height="220" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Yellow" Content="TESTING" FontSize="80" FontWeight="Bold" Foreground="Black" Visibility="Collapsed" />
                <Label x:Name="readyPopup" HorizontalAlignment="Center" Width="520" Height="220" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Orange" Content="READY" FontSize="80" FontWeight="Bold" Foreground="White" Visibility="Collapsed" />
                <Label x:Name="passPopup" HorizontalAlignment="Center" Width="520" Height="220" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#06C755" Content="PASS" FontSize="80" FontWeight="Bold" Foreground="White" Visibility="Collapsed" />
            </Grid>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock x:Name="totalCount" HorizontalAlignment="Center" FontSize="70" FontWeight="Bold" Text="{Binding TotalCnt}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="34" Text="Total" />
                </StackPanel>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="48,0">
                    <TextBlock x:Name="passCount" HorizontalAlignment="Center" FontSize="70" FontWeight="Bold" Foreground="#06C755" Text="{Binding PassCnt}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="34" Foreground="#06C755" Text="Pass" />
                </StackPanel>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock x:Name="failCount" HorizontalAlignment="Center" FontSize="70" FontWeight="Bold" Foreground="Red" Text="{Binding FailCnt}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="34" Foreground="Red" Text="Fail" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Used Pins" VerticalAlignment="Center" FontSize="24" />
                <Label Content="{Binding SettingModel.SettingVal.CurNum}" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" />
                <Label Content="/" VerticalAlignment="Center" FontSize="40" />
                <Label Content="{Binding SettingModel.SettingVal.MaxNum}" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" />
                <Label Content="times" VerticalAlignment="Center" FontSize="24" />
            </StackPanel>

            <!--  Buộc chạy test khi không có tín hiệu trigger gửi tới  -->
            <Button Click="TestForce_Click" Width="220" Height="52" Margin="0,30,0,0" Cursor="Hand" Focusable="False"
                    ToolTip="Buộc chạy test khi không có tín hiệu trigger gửi tới">
                <Button.Style>
                    <!--  Nút phẳng xám, chữ + icon tối, rê chuột đậm hơn một chút  -->
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#E1E5EA" />
                        <Setter Property="Foreground" Value="#323F4E" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <fa:IconImage Width="20" Height="20" Margin="0,0,12,0" Foreground="#323F4E" Icon="CirclePlay" />
                                            <TextBlock Text="TEST FORCE" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#D2D8DF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#C0C8D1" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
       



        <StackPanel  Grid.Row="1" Grid.ColumnSpan="2"
>

            

            <StackPanel Background="Red" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10 5">

  
                <Label Height="50" Foreground="White"
FontSize="20"
Content="⚠ Warning: Maximum test pin usage reached. Replace the pin on the fixture and press"
HorizontalContentAlignment="Center"
VerticalContentAlignment="Center">
                    <Label.Style>
                        <Style TargetType="Label">
                            <!-- Mặc định: Ẩn -->
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <!-- Có warning -->
                                <DataTrigger Binding="{Binding SettingModel.SettingVal.ShouldWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
                <Button Content="RESET" Click="ResetCurNum_Click" Cursor="Hand" FontSize="20"  Padding="5 0"  Width="80" Margin="2" Background="Transparent" Foreground="White" BorderBrush="White">
                    <Button.Style>
                        <Style TargetType="Button">
                            <!-- Mặc định: Ẩn -->
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingModel.SettingVal.ShouldWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
               
        </StackPanel>

  
    </Grid>
</Page>