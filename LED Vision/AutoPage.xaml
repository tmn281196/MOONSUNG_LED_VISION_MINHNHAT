<Page
    x:Class="LEDVision.AutoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LEDVision"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vt="clr-namespace:LEDVision.Camera"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    Title="AutoPage">

    <Grid>


        <!--  3 cột: camera | thống kê + START | bảng step  -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <!--  Khung chứa CỐ ĐỊNH 680x906 (giữ đúng chỗ trên UI). Canvas căn giữa ở ĐÚNG kích thước tỉ lệ
                  ảnh thô (EnsureSurfaceSized scale tới khi chạm 2 cạnh) — KHÔNG scale thêm → không méo.  -->
            <Grid Width="680" Height="906" Background="Black" Margin="12,0,12,0">
                <Canvas
                    x:Name="mainCanvas"
                    Width="680"
                    Height="906"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
                    <Image
                        x:Name="cameraViewer"
                        Width="680" Height="906" Stretch="Uniform" />
                    <vt:VisionTester
                        x:Name="visionTester"
                        Width="680" Height="906" />
                </Canvas>
            </Grid>
        </StackPanel>

        <!--  Cột phải gom chung: Model + Total/Pass/Fail + Used Pins xếp dọc, căn giữa  -->
        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!--  Banner trạng thái/kết quả: vùng CỐ ĐỊNH trên cùng, chỉ 1 cái hiện → không đè lên số bên dưới  -->
            <Grid Height="240" Margin="0,0,0,16">
                <Label x:Name="ngPopup" HorizontalAlignment="Center" Width="520" Height="220" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Red" Content="NG" FontSize="80" FontWeight="Bold" Foreground="White" Visibility="Collapsed" />
                <Label x:Name="testingPopup" HorizontalAlignment="Center" Width="520" Height="220" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#E0A800" Content="TESTING" FontSize="80" FontWeight="Bold" Foreground="White" Visibility="Collapsed" />
                <Label x:Name="readyPopup" HorizontalAlignment="Center" Width="520" Height="220" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#007ACC" Content="READY" FontSize="80" FontWeight="Bold" Foreground="White" Visibility="Collapsed" />
                <Label x:Name="passPopup" HorizontalAlignment="Center" Width="520" Height="220" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#06C755" Content="PASS" FontSize="80" FontWeight="Bold" Foreground="White" Visibility="Collapsed" />
            </Grid>


            <!--  Khung xám nhẹ gom Total / Pass / Fail, Used Pins và nút TEST FORCE  -->
            <Border Width="520" Background="#F4F6F8" BorderBrush="#DDE3EA" BorderThickness="1" Padding="24,28,24,28">
            <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <!--  Cột TOTAL: rê chuột vào là nút CLEAR hiện đè lên chữ TOTAL  -->
                <StackPanel x:Name="totalCol" Orientation="Vertical" HorizontalAlignment="Center" Background="Transparent">
                    <TextBlock x:Name="totalCount" HorizontalAlignment="Center" FontSize="70" FontWeight="Bold" Text="{Binding TotalCnt}" />
                    <Grid>
                        <TextBlock HorizontalAlignment="Center" FontSize="34" Text="TOTAL" />
                        <Button Click="ClearCounters_Click" Content="CLEAR" FontSize="16" FontWeight="Bold" Cursor="Hand" Focusable="False"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E5484D" Foreground="White" BorderThickness="0"
                                ToolTip="Reset TOTAL / PASS / FAIL counters">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=totalCol}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="48,0">
                    <TextBlock x:Name="passCount" HorizontalAlignment="Center" FontSize="70" FontWeight="Bold" Text="{Binding PassCnt}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="34" Text="PASS" />
                </StackPanel>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock x:Name="failCount" HorizontalAlignment="Center" FontSize="70" FontWeight="Bold" Text="{Binding FailCnt}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="34" Text="FAIL" />
                </StackPanel>
            </StackPanel>

            <!--  Đèn trạng thái xi lanh (một cảm biến dưới): DOWN xanh lá khi phát hiện, UP xanh dương khi không, gạch ngang khi chưa nối COM  -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="CYLINDER" FontSize="16" Foreground="#6B7A8C" VerticalAlignment="Center" />
                <Ellipse x:Name="cylinderDot" Width="14" Height="14" Fill="Gray" Margin="10,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="cylinderText" Text="--" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Used Pins" VerticalAlignment="Center" FontSize="24" />
                <Label Content="{Binding SettingModel.SettingVal.CurNum}" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" />
                <Label Content="/" VerticalAlignment="Center" FontSize="40" />
                <Label Content="{Binding SettingModel.SettingVal.MaxNum}" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" />
                <Label Content="times" VerticalAlignment="Center" FontSize="24" />
            </StackPanel>

            <!--  Buộc chạy test khi không có tín hiệu trigger gửi tới  -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <!--  "?" : hướng dẫn trang Auto + timeline chuỗi test (EN / TH)  -->
            <Button Click="AutoHelp_Click" Width="34" Height="44" Margin="0,30,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" ToolTip="Help: how the auto test works (EN / TH)">
                <fa:IconImage Width="20" Height="20" Foreground="#323F4E" Icon="CircleQuestion" />
            </Button>
            <Button x:Name="startBtn" Content="START" Click="TestForce_Click" Width="200" Height="44" Margin="0,30,0,0" Cursor="Hand" Focusable="False"
                    ToolTip="Start a test manually (no trigger needed). While a test runs this button becomes EMERGENCY STOP.">
                <Button.Style>
                    <!--  Nút phẳng xám, chữ + icon tối, rê chuột đậm hơn một chút  -->
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#E1E5EA" />
                        <Setter Property="Foreground" Value="#323F4E" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#D2D8DF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#C0C8D1" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <!--  Toggle mắt: bật = hiện TẤT CẢ ROI với kết quả lần kiểm tra gần nhất (xanh OK, đỏ NG, xám chưa kiểm tra); tắt = ẩn hết  -->
            <ToggleButton x:Name="allRoiBtn" Width="200" Height="36" Margin="42,8,0,0" Cursor="Hand" Focusable="False" Click="AllRoi_Click"
                          ToolTip="Show / hide all ROIs with their last result (green = OK, red = NG, grey = not checked)">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background" Value="#E1E5EA" />
                        <Setter Property="Foreground" Value="#323F4E" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <fa:IconImage x:Name="ic" Width="20" Height="20" Foreground="{TemplateBinding Foreground}" Icon="EyeSlash" />
                                            <TextBlock Text="ALL ROI" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#D2D8DF" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#323F4E" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter TargetName="ic" Property="Icon" Value="Eye" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            </StackPanel>
            </StackPanel>
            </Border>


        </StackPanel>




        <!--  Cột 3: chuỗi step của model: Value / Result cập nhật theo từng bước khi test  -->
        <Border Grid.Column="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Margin="0,24,24,24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <DataGrid x:Name="stepsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E6EBF0" RowBackground="White" AlternatingRowBackground="#F7F9FB" BorderThickness="0"
                      CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                      SelectionMode="Single" FontSize="13" RowHeight="26" Focusable="False" IsHitTestVisible="False"
                      ToolTip="Test sequence of the model (edit on the Sequence page, then Save)">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F6F8" />
                        <Setter Property="Foreground" Value="#323F4E" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#DDE3EA" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Skip}" Value="True">
                                <Setter Property="Foreground" Value="#9AA5B1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No" Binding="{Binding No}" Width="36" />
                    <DataGridTextColumn Header="Step" Binding="{Binding Label}" Width="*" />
                    <DataGridTextColumn Header="Spec" Binding="{Binding Spec}" Width="64" />
                    <DataGridTextColumn Header="Timeout" Binding="{Binding Timeout}" Width="70" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100" />
                    <DataGridTemplateColumn Header="Result" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Result}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#6B7A8C" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result}" Value="PASS"><Setter Property="Foreground" Value="#06C755" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="FAIL"><Setter Property="Foreground" Value="#E5484D" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="RUN"><Setter Property="Foreground" Value="#E0A800" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Takt" Binding="{Binding Takt}" Width="52" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel  Grid.Row="1" Grid.ColumnSpan="3"
>



            <StackPanel Background="Red" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10 5">


                <Label Height="50" Foreground="White"
FontSize="20"
Content="⚠ Warning: Maximum test pin usage reached. Replace the pin on the fixture and press"
HorizontalContentAlignment="Center"
VerticalContentAlignment="Center">
                    <Label.Style>
                        <Style TargetType="Label">
                            <!-- Mặc định: Ẩn -->
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <!-- Có warning -->
                                <DataTrigger Binding="{Binding SettingModel.SettingVal.ShouldWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>

                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
                <Button Content="RESET" Click="ResetCurNum_Click" Cursor="Hand" FontSize="20"  Padding="5 0"  Width="80" Margin="2" Background="Transparent" Foreground="White" BorderBrush="White">
                    <Button.Style>
                        <Style TargetType="Button">
                            <!-- Mặc định: Ẩn -->
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingModel.SettingVal.ShouldWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>

        </StackPanel>


    </Grid>
</Page>