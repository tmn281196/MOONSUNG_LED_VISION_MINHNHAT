<Window x:Class="LEDVision.CameraSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LEDVision"
        mc:Ignorable="d"
        Title="Camera Settings"
        Width="560" Height="720"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="ParamSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="TickFrequency" Value="1" />
        </Style>
        <Style x:Key="ParamValue" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#323F4E" />
            <Setter Property="Margin" Value="0,4,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border Grid.Row="0" Background="#323F4E" Padding="14,10">
            <StackPanel>
                <TextBlock Text="CAMERA SETTINGS"
                           Foreground="White" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="Shared for all objects (4-LED / DP / 7-SEG)"
                           Foreground="#80C4E9" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!--  Parameters  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>

                <!--  Auto toggles  -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Auto" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox Content="Auto Exposure" Margin="0,0,18,0" VerticalContentAlignment="Center"
                              IsChecked="{Binding AutoExposure, Mode=TwoWay}" />
                    <CheckBox Content="Auto White Balance" Margin="0,0,18,0" VerticalContentAlignment="Center"
                              IsChecked="{Binding AutoWhiteBalance, Mode=TwoWay}" />
                    <CheckBox Content="Auto Focus" VerticalContentAlignment="Center"
                              IsChecked="{Binding AutoFocus, Mode=TwoWay}" />
                </StackPanel>

                <Separator Margin="0,0,0,8" />

                <!--  Manual sliders  -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Manual" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>

                    <!--  Exposure  -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Exposure" />
                    <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="-13" Maximum="0" Value="{Binding Exposure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Exposure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Gain  -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Gain" />
                    <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="0" Maximum="255" Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Brightness  -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Brightness" />
                    <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="0" Maximum="255" Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Contrast  -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Contrast" />
                    <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="0" Maximum="255" Value="{Binding Contrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Contrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Saturation  -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Saturation" />
                    <Slider Grid.Row="4" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="0" Maximum="255" Value="{Binding Saturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="4" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Saturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Hue  -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Hue" />
                    <Slider Grid.Row="5" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="-180" Maximum="180" Value="{Binding Hue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="5" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Hue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Gamma  -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Gamma" />
                    <Slider Grid.Row="6" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="0" Maximum="500" Value="{Binding Gamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="6" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Gamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Sharpness  -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Sharpness" />
                    <Slider Grid.Row="7" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="0" Maximum="255" Value="{Binding Sharpness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="7" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Sharpness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Backlight  -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Backlight Comp" />
                    <Slider Grid.Row="8" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="0" Maximum="10" Value="{Binding BacklightComp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="8" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding BacklightComp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  White Balance  -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="White Balance" />
                    <Slider Grid.Row="9" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="2000" Maximum="6500" TickFrequency="10"
                            Value="{Binding WhiteBalanceBlueU, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="9" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding WhiteBalanceBlueU, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Focus  -->
                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Focus" />
                    <Slider Grid.Row="10" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="0" Maximum="255" Value="{Binding Focus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="10" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Focus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Zoom  -->
                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Zoom" />
                    <Slider Grid.Row="11" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="0" Maximum="500" Value="{Binding Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="11" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Pan  -->
                    <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Pan" />
                    <Slider Grid.Row="12" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="-180" Maximum="180" Value="{Binding Pan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="12" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Pan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Tilt  -->
                    <TextBlock Grid.Row="13" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="Tilt" />
                    <Slider Grid.Row="13" Grid.Column="1" Style="{StaticResource ParamSlider}"
                            Minimum="-180" Maximum="180" Value="{Binding Tilt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Row="13" Grid.Column="2" Style="{StaticResource ParamValue}"
                             Text="{Binding Tilt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--  Actions  -->
        <Border Grid.Row="2" Background="#F2F4F7" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Revert" Width="90" Height="34" Margin="6,0" Click="Revert_Click"
                        ToolTip="Restore parameters from the loaded model file" />
                <Button Content="Close" Width="80" Height="34" Margin="6,0" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
