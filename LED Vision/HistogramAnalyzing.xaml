<Window x:Class="LEDVision.HistogramAnalyzing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LEDVision"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Width="840"  Height="350" Left="20"  Top="650"
        Title="Histogram HSV" >
    <Grid>
      

        <StackPanel Grid.Column="0" Margin="10 0" VerticalAlignment="Center">
            <TabControl>
                <TabItem Header="Hue">
                    <StackPanel Orientation="Horizontal" >
                        <lvc:CartesianChart Name="HueChart" Height="240"  DisableAnimations="True" MouseDown="Chart_MouseDown" Width="600" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                            <StackPanel Orientation="Horizontal" Margin="40 0"  VerticalAlignment="Center" HorizontalAlignment="Center" >
                                <TextBox x:Name="HueMin"   PreviewMouseLeftButtonDown="TextBlockColor_Click"    Width="50"  Padding="5" VerticalAlignment="Center"  TextAlignment="Center" >0</TextBox>
                                <Label Content="~" />
                                <TextBox x:Name="HueMax"   PreviewMouseLeftButtonDown="TextBlockColor_Click"    Width="50" Padding="5" VerticalAlignment="Center"  TextAlignment="Center" >179</TextBox>
    
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 5">
                                <Button Click="ApplyRange_Click" Width="80" Height="30" Padding="5" Margin="5">Apply</Button>
                                <Button Click="Cancel_Click" Width="80" Height="30" Padding="5" Margin="5">Cancel</Button>
                            </StackPanel>
                        </StackPanel>
                   

                    </StackPanel>
                </TabItem>
                <TabItem Header="Sat">
                    <StackPanel Orientation="Horizontal" >
                        <lvc:CartesianChart Name="SatChart" Height="240"  DisableAnimations="True" MouseDown="Chart_MouseDown" Width="600" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="40 0"  VerticalAlignment="Center" HorizontalAlignment="Center" >
                                <TextBox x:Name="SatMin"   PreviewMouseLeftButtonDown="TextBlockColor_Click"    Width="50"  Padding="5" VerticalAlignment="Center"  TextAlignment="Center" >0</TextBox>
                                <Label Content="~" />
                                <TextBox x:Name="SatMax"   PreviewMouseLeftButtonDown="TextBlockColor_Click"    Width="50" Padding="5" VerticalAlignment="Center"  TextAlignment="Center" >255</TextBox>

                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 5">
                                <Button Click="ApplyRange_Click" Width="80" Height="30" Padding="5" Margin="5">Apply</Button>
                                <Button Click="Cancel_Click" Width="80" Height="30" Padding="5" Margin="5">Cancel</Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Value">
                    <StackPanel Orientation="Horizontal" >
                        <lvc:CartesianChart Name="ValueChart" Height="240"  DisableAnimations="True" MouseDown="Chart_MouseDown" Width="600" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="40 0"  VerticalAlignment="Center" HorizontalAlignment="Center" >
                                <TextBox x:Name="ValueMin"   PreviewMouseLeftButtonDown="TextBlockColor_Click"    Width="50"  Padding="5" VerticalAlignment="Center"  TextAlignment="Center" >0</TextBox>
                                <Label Content="~" />
                                <TextBox x:Name="ValueMax"   PreviewMouseLeftButtonDown="TextBlockColor_Click"    Width="50" Padding="5" VerticalAlignment="Center"  TextAlignment="Center" >255</TextBox>

                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 5">
                                <Button Click="ApplyRange_Click" Width="80" Height="30" Padding="5" Margin="5">Apply</Button>
                                <Button Click="Cancel_Click" Width="80" Height="30" Padding="5" Margin="5">Cancel</Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>

       

    </Grid>
</Window>
